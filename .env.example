# 从 DIAL 申请的 API Key；不要提交真实值。
DIAL_API_KEY=replace-with-your-dial-api-key

# 本地 LiteLLM Proxy 的访问密钥。请使用随机长字符串。
LITELLM_MASTER_KEY=sk-replace-with-a-random-local-secret

# GitHub Webhook 的 Secret。使用随机长字符串；GitHub 仓库的 Webhook Secret 必须完全相同。
GITHUB_WEBHOOK_SECRET=replace-with-a-random-github-webhook-secret

# Hermes Dashboard / Kanban login for http://localhost:9119.
# Use a dedicated username and strong random password and session secret.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-a-strong-dashboard-password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-with-a-random-session-secret

# Optional host path for mutable Hermes state. Default on Windows:
# C:\Users\<your-user>\.hermes-dial
# HERMES_DATA_DIR=C:\path\outside\this\repository\hermes-data
